# ---------- Debug ----------
VITE_CHAT_DEBUG=true
VITE_REDUX_LOG=false
VITE_WS_DEBUG_LEVEL=2

VITE_SEND_DEBUG=true

# ---------- Default backend (fallback) ----------
# اگر backendChoice نبود، apiClient از این استفاده می‌کند
VITE_API_URL=http://localhost:3000/api


# ---------- Backend API ORIGINS (no /api) ----------
VITE_API_ORIGIN_REVERB=http://localhost:8000
VITE_API_ORIGIN_NODE=http://localhost:3000
VITE_API_ORIGIN_NEST=http://localhost:9100
VITE_API_ORIGIN_DJANGO=http://localhost:8001
VITE_API_ORIGIN_FASTAPI=http://localhost:8002

# ---------- Backend API BASE (with /api) ----------
# استاندارد: همه این‌ها باید به ریشه API (prefix /api) اشاره کنند
VITE_API_BASE_REVERB=http://localhost:8000/api
VITE_API_BASE_NODE=http://localhost:3000/api
VITE_API_BASE_NEST=http://localhost:9100/api
VITE_API_BASE_DJANGO=http://localhost:8001/api
VITE_API_BASE_FASTAPI=http://localhost:8002/api

# ---------- Reverb / Pusher (websocket) ----------
VITE_PUSHER_KEY=local
VITE_PUSHER_CLUSTER=mt1
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=8080
VITE_PUSHER_TLS=false

# Broadcasting auth endpoint باید با بک‌اند reverb/laravel یکی باشد
VITE_PUSHER_AUTH_ENDPOINT=http://localhost:8000/api/broadcasting/auth



# ✅ Socket.io for node
VITE_NODE_WS_URL=http://localhost:3000
VITE_NODE_WS_PATH=/socket.io
